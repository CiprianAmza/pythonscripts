def different_squares(matrix):
    
    ans = set()
    for i in range(len(matrix)-1):
        for j in range(len(matrix[i])-1):
            a, b = matrix[i][j], matrix[i][j+1]
            c, d = matrix[i+1][j], matrix[i+1][j+1]

            ans.add(tuple([a, b, c, d]))
    
    return len(ans)
                     
