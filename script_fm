from pathlib import Path
from collections import defaultdict
import re

TACTIC = "GK-DL-DC-DC-DR-MC-MC-AML-AMR-ST-ST"

PITCH_LINES = [
    ["STL", "ST", "STR"],
    ["AML", "AMC", "AMR"],
    ["ML", "MC", "MR"],
    ["DML", "DM", "DMR"],
    ["WBL", "WBC", "WBR"],
    ["DL", "DC", "DR"],
    ["GK"],
]
POSITION_ORDER = [position for row in reversed(PITCH_LINES) for position in row]

ATTRIBUTE_NAMES = [
    "Pac", "Acc", "Jum", "Dri", "Bal", "Cnt",
    "Ant", "Det", "Agi", "Sta", "Str", "Fir"
]

ATTRIBUTE_WEIGHTS = [
    4.5,  # Pace          ===
    4.5,  # Acceleration  ===
    1.7,  # Jumping Reach ===
    1.8,  # Dribbling      1
    1.2,  # Balance       ===
    1.1,  # Concentration  2
    1.6,  # Anticipation   2
    0.8,  # Determination  2
    0.9,  # Agility       ===
    1.7,  # Stamina       ===
    1.0,  # Strength      ===
    0.5,  # First Touch
]


def calculate_score(attributes, weights=ATTRIBUTE_WEIGHTS):
    return sum(value * weight for value, weight in zip(attributes, weights)) / sum(weights)


def parse_player_line(line, file_type="default"):
    parts = line.split("|")

    if len(parts) < 30:
        return None

    parts = parts[2:]

    if not parts or parts[0].strip() == "Inf":
        return None

    try:
        name = parts[1].strip()
        position = parts[14].strip()
        age = parts[15].strip()
        team = parts[16].strip()
        wage = parts[23].strip()
        value = parts[24].strip()
        expires = parts[26].strip()
        release_clause = parts[25].strip()

        attributes = [int(x.strip()) for x in parts[2:14]]

    except (ValueError, IndexError):
        return None

    score = calculate_score(attributes)

    return {
        "name": name,
        "score": score,
        "position": position,
        "team": team,
        "age": age,
        "wage": wage,
        "value": value,
        "expires": expires,
        "attributes": attributes,
        "release_clause": release_clause
    }


def load_players(file_path, file_type="default"):
    players = []

    with open(file_path, "r", encoding="utf-8") as file:
        for line in file:
            player = parse_player_line(line, file_type=file_type)
            if player is not None:
                players.append(player)

    return players


