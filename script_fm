def get_positions(position_text):
    """Descompune pozițiile FM, inclusiv D/WB/M (L) și AM (RC)."""
    positions = set()
    pattern = r"\b(GK|(?:WB|DM|AM|ST|D|M)(?:/(?:WB|DM|AM|ST|D|M))*)\b(?:\s*\(([RLC]+)\))?"
    for match in re.finditer(pattern, position_text.upper()):
        roles, sides = match.groups()
        for role in roles.split("/"):
            if role == "GK":
                positions.add("GK")
                continue
            for side in sides or "C":
                positions.add(role if role in {"DM", "ST"} and side == "C" else role + side)
    return positions


def group_players_by_position(players):
    groups = defaultdict(list)
    for player in players:
        for position in get_positions(player["position"]):
            groups[position].append(player)
    for group in groups.values():
        group.sort(key=lambda player: player["score"], reverse=True)
    return groups


def player_label(player):
    return f"{player['name']} {player['score']:.2f} ({player['age']})"


def print_position_groups(groups):
    print("\n=== JUCĂTORI PE POSTURI ===\n")
    for position in POSITION_ORDER:
        if position in groups:
            print(f"{position}: " + ", ".join(player_label(player) for player in groups[position]))


def select_lineup(players, tactic):
    """Maximizează posturile ocupate, apoi scorul total, fără reutilizare."""
    slots = [slot.strip().upper() for slot in tactic.split("-")]
    if len(slots) != 11:
        raise ValueError("Tactica trebuie să conțină exact 11 posturi.")
    unknown = set(slots) - set(POSITION_ORDER)
    if unknown:
        raise ValueError("Posturi necunoscute: " + ", ".join(sorted(unknown)))
    if slots.count("GK") != 1:
        raise ValueError("Tactica trebuie să conțină exact un GK.")

    states = {0: (0.0, (None,) * len(slots))}
    for player_index, player in enumerate(players):
        positions = get_positions(player["position"])
        eligible_slots = [i for i, position in enumerate(slots) if position in positions]
        if not eligible_slots:
            continue
        # Snapshot: stările noi nu pot folosi din nou jucătorul curent.
        for mask, (total, assignment) in list(states.items()):
            for slot_index in eligible_slots:
                bit = 1 << slot_index
                if mask & bit:
                    continue
                new_mask = mask | bit
                new_total = total + player["score"]
                if new_mask not in states or new_total > states[new_mask][0]:
                    new_assignment = list(assignment)
                    new_assignment[slot_index] = player_index
                    states[new_mask] = (new_total, tuple(new_assignment))

    best_mask = max(states, key=lambda mask: (bin(mask).count("1"), states[mask][0]))
    total_score, assignment = states[best_mask]
    lineup = [
        {"position": position, "player": players[index] if index is not None else None}
        for position, index in zip(slots, assignment)
    ]
    return lineup, total_score


def outfield_average(lineup):
    scores = [
        item["player"]["score"]
        for item in lineup
        if item["position"] != "GK" and item["player"] is not None
    ]
    return sum(scores) / len(scores) if scores else None


def print_tactical_lineup(lineup, total_score):
    print("\n=== AȘEZARE TACTICĂ (ATAC SUS) ===\n")
    cell_width = max([26] + [
        len(player_label(item["player"])) + 4
        for item in lineup if item["player"] is not None
    ])
    rows = [
        [item for position in pitch_line for item in lineup if item["position"] == position]
        for pitch_line in PITCH_LINES
    ]
    rows = [row for row in rows if row]
    pitch_width = max(len(row) for row in rows) * cell_width
    print("=" * pitch_width)
    for row in rows:
        positions = "".join(item["position"].center(cell_width) for item in row)
        names = "".join(
            (player_label(item["player"]) if item["player"] is not None else "LIPSĂ JUCĂTOR")
            .center(cell_width)
            for item in row
        )
        print(positions.center(pitch_width))
        print(names.center(pitch_width))
        print()
    print("=" * pitch_width)
    occupied = sum(item["player"] is not None for item in lineup)
    print(f"Posturi ocupate: {occupied}/{len(lineup)}")
    print(f"Scor total: {total_score:.2f}")
    average = outfield_average(lineup)
    outfield_count = sum(
        item["position"] != "GK" and item["player"] is not None
        for item in lineup
    )
    if average is not None:
        print(f"Media echipei fără GK: {average:.2f} ({outfield_count} jucători de câmp)")
    else:
        print("Media echipei fără GK: N/A (niciun jucător de câmp)")


def print_club_lineups(players, tactic):
    clubs = defaultdict(list)
    for player in players:
        clubs[player["team"]].append(player)

    print(f"\nEchipe găsite: {len(clubs)}")
    print(f"Tactică: {tactic}")

    ranked_clubs = []
    for club, club_players in clubs.items():
        lineup, total_score = select_lineup(club_players, tactic)
        average = outfield_average(lineup)
        ranked_clubs.append((club, lineup, total_score, average))

    ranked_clubs.sort(key=lambda item: (
        -(item[3] if item[3] is not None else float("-inf")),
        item[0].casefold(),
    ))

    for rank, (club, lineup, total_score, average) in enumerate(ranked_clubs, start=1):
        club_players = clubs[club]
        print(f"\n{'=' * 80}")
        average_text = f"{average:.2f}" if average is not None else "N/A"
        print(f"{rank}. CLUB: {club or 'Fără echipă'} | Jucători: {len(club_players)} | Media fără GK: {average_text}")
        print("=" * 80)
        print_position_groups(group_players_by_position(club_players))
        print_tactical_lineup(lineup, total_score)


