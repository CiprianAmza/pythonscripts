def watchtower(s: str) -> str:
    
    ss = set()
    
    for i, j in enumerate(s):
        if j.isupper():
            r = ord(j) - ord('A') + 1
            for w in range(r+1):
                ss.add(i+w)
                ss.add(i-w)
    
    return "".join([s[i] for i in sorted(ss) if i >= 0 and i < len(s)])
